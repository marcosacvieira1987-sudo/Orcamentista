# Supabase (Project Settings → API Keys). Crie o projeto numa região da UE (ex.: Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública ("publishable", sb_publishable_...; ou a antiga "anon").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta ("secret", sb_secret_...; ou a antiga "service_role"). Só no servidor:
# usada para apagar a conta (RGPD) e para gravar as subscrições vindas do Stripe. Nunca a exponha no browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Claude API (console.anthropic.com → API Keys). Só no servidor.
ANTHROPIC_API_KEY=sk-ant-...

# Pedidos à IA por utilizador em 24 h (controlo de custos).
LIMITE_IA_DIA=80

# Pagamentos (Stripe). Sem STRIPE_SECRET_KEY os botões de subscrever mostram "pagamentos ainda não ativos".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs dos preços mensais (price_...) criados no painel do Stripe
STRIPE_PRECO_PRO=
STRIPE_PRECO_PREMIUM=
# IVA: ou uma taxa de imposto do Stripe (txr_..., 23 %, exclusiva), ou STRIPE_IVA_AUTOMATICO=1 com o Stripe Tax ativo
STRIPE_TAXA_IVA=
STRIPE_IVA_AUTOMATICO=
# Emails com acesso total sem subscrição, separados por vírgulas
CONTAS_ISENTAS=
