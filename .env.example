# Supabase (Project Settings → API Keys). Crie o projeto numa região da UE (ex.: Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública ("publishable", sb_publishable_...; ou a antiga "anon").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta ("secret", sb_secret_...; ou a antiga "service_role"). Só no servidor:
# usada para apagar a conta (RGPD), gravar as subscrições vindas do Stripe e reservar o limite diário da IA. Nunca a exponha no browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Claude API (console.anthropic.com → API Keys). Só no servidor.
ANTHROPIC_API_KEY=sk-ant-...

# Pedidos à IA por utilizador em 24 h (controlo de custos).
LIMITE_IA_DIA=80

# Pagamentos (Stripe). Passo a passo em docs/pagamentos.md.
# Os produtos, os 12 preços, o IVA e o portal criam-se com o botão "Criar o que falta no Stripe" (página Plano, CONTAS_ADMIN).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: uma taxa de IVA já existente (txr_...); sem ela usa a criada pelo botão. Ou STRIPE_IVA_AUTOMATICO=1 com o Stripe Tax.
STRIPE_TAXA_IVA=
STRIPE_IVA_AUTOMATICO=
# Emails separados por vírgulas:
# administradores (veem a administração do Stripe na página Plano)
CONTAS_ADMIN=
# acesso total sem subscrição e sem limite
CONTAS_ISENTAS=
# colegas da beta: preço de lançamento sem prazo e 1.º mês grátis
BETA_EMAILS=
# Venda ao preço de lançamento (UTC). Por omissão: 27 a 30 nov 2026, hora de Lisboa.
LANCAMENTO_INICIO=2026-11-27T00:00:00Z
LANCAMENTO_FIM=2026-11-30T23:59:59Z

# Avisos por email quando um cliente aceita uma proposta (opcional; sem isto o aviso aparece só no app).
# Conta em resend.com, com o domínio próprio verificado. Ex.: EMAIL_REMETENTE="Prumo <avisos@prumo.pt>"
RESEND_API_KEY=
EMAIL_REMETENTE=
